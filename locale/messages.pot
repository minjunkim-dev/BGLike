msgid "적·나무 상자·바위 좌클릭: 고른 동작(처음에는 기본 공격)의 대상과 명중률 같은 미리보기를 봅니다. 같은 대상을 다시 좌클릭하면 실행합니다. 밀치기는 아군도 고를 수 있습니다."
msgstr ""

#: scenes/help.tscn
msgid "스킬 바 버튼: 스킬·밀치기·물약을 고릅니다. 자기에게 쓰는 동작은 같은 버튼을 다시 누르면 씁니다."
msgstr ""

#: scenes/help.tscn
msgid "초상: HP·AC·6능력치 주사위·상태를 봅니다. 현재 턴 묶음에서 조작 가능한 아군 초상을 누르면 해당 유닛을 조작합니다."
msgstr ""

#: scenes/help.tscn
msgid "턴 종료 버튼: 지금 유닛의 턴을 끝냅니다."
msgstr ""

#: scenes/help.tscn
msgid "전투 시작 버튼: 전투 전에 지형과 적을 확인한 뒤 눌러 전투를 시작합니다. 처음에는 이 버튼에 포커스가 있어 Enter·컨트롤러 A로도 누릅니다."
msgstr ""

#: scenes/help.tscn
msgid "정비: 보상·가방 아이템을 캐릭터 카드나 같은 종류 칸으로 끌어 장착하거나 물약을 건넵니다. 보상은 가방 빈 칸으로 끌어 보관하고, 장착한 방어구는 가방 빈 칸으로 끌어 해제합니다. 끄는 중에 Esc를 누르면 취소합니다."
msgstr ""

#: scenes/help.tscn
msgid "정비 버튼: 칸을 고른 뒤 아래 상세 패널의 버튼으로 장착·물약 전달·해제·버리기를 합니다. 캐릭터의 물약은 다른 캐릭터에게 끌거나 카드의 물약 1개 → 버튼으로 한 개씩 건넵니다."
msgstr ""

#: scenes/help.tscn
msgid "설명 보기: 스킬 바 버튼·정비 칸과 버튼·초상에 마우스를 올리면 잠시 뒤 설명이 나옵니다. 스킬 바와 정비 화면에서는 키보드·컨트롤러로 포커스를 옮겨도 나옵니다. 스킬 바의 행동·보조 행동 버튼과 정비 화면의 장착·전달·해제 버튼이 꺼져 있으면 쓸 수 없는 이유가 나옵니다."
msgstr ""

#: scenes/help.tscn
msgid "휠: 포인터 자리를 중심으로 맵을 2배로 확대하고 다시 1배로 줄입니다. 가운데 버튼 드래그로 맵을 옮깁니다. 트랙패드는 두 손가락으로 옮기고 집기로 확대합니다."
msgstr ""

#: scenes/help.tscn
msgid "키보드·컨트롤러"
msgstr ""

#: scenes/help.tscn
msgid "숫자 키 1~9: 아군 턴에 스킬 바의 버튼을 왼쪽부터 고릅니다."
msgstr ""

#: scenes/help.tscn
msgid "방향키·D-pad: 버튼 사이를 옮깁니다. 전투에서 포커스가 없으면 좌우 입력으로 스킬 바 첫 버튼에 들어갑니다. 도움말·출처 화면에서는 위아래로 글을 스크롤합니다."
msgstr ""

#: scenes/help.tscn
msgid "Enter·컨트롤러 A: 포커스된 버튼을 누릅니다."
msgstr ""

#: scenes/help.tscn
msgid "Tab: 같은 묶음의 다음 아군으로 바꿉니다. Shift+Tab은 이전 아군입니다. 바꿔도 자원은 회복하지 않습니다."
msgstr ""

#: scenes/help.tscn
msgid "Space 누르고 있기: 적 턴을 4배로 빠르게 봅니다. 손을 떼면 보통 속도로 돌아옵니다."
msgstr ""

#: scenes/help.tscn
msgid "Esc·컨트롤러 Start: 전투·정비 중에 일시정지 메뉴를 열고 닫습니다. 메뉴가 열려 있는 동안 전투가 멈춥니다. 반응 확인 창에서 Esc는 반응을 넘깁니다. 다른 확인 창과 설정·도움말·출처 화면은 Esc로 닫습니다."
msgstr ""

#: scenes/help.tscn
msgid "WASD: 맵을 옮깁니다. C: 맵을 1배로 줄이고 가운데로 되돌립니다. 맵이 화면 밖으로 나가지 않고, 적 턴에도 움직일 수 있습니다."
msgstr ""

#: scenes/help.tscn
msgid "유리 / 불리"
msgstr ""

#: scenes/help.tscn
msgid "유리는 공격 능력치 주사위를 두 번 굴려 높은 값을, 불리는 낮은 값을 씁니다. 유리 요인과 불리 요인의 수를 비교해 많은 쪽을 따르고, 같으면 한 번만 굴립니다. 요인이 여러 개여도 두 번만 굴립니다."
msgstr ""

#: scenes/help.tscn
msgid "기절한 대상을 공격하면 유리입니다. 원거리 공격자의 인접 칸에 기절하지 않은 적이 있으면 불리입니다."
msgstr ""

#: scenes/help.tscn
msgid "공격 굴림(공격 능력치 주사위 + 공격 가산)이 대상의 AC 이상이면 명중합니다. 대상은 굴리지 않습니다. 절대성공면은 AC와 무관하게 명중하고 절대실패면은 가산이 있어도 빗나갑니다. 명중률에는 유리/불리, 절대면과 장비 가산이 반영됩니다."
msgstr ""

#: scenes/help.tscn
msgid "능력치 주사위와 AC"
msgstr ""

#: scenes/help.tscn
msgid "힘·민첩·솜씨·지능·의지·건강은 각각 능력치 주사위입니다. 공격 능력치는 무기·스킬이 정합니다(전사 힘, 아군 궁수 솜씨). AC는 민첩 주사위의 표준값(d4 3, d6 4, d8 5, d10 6, d12 7, d20 11)에 방어 가산을 더한 값입니다. 모든 주사위의 첫 면은 절대실패면이고, d12의 가장 높은 면 하나와 d20의 가장 높은 면 셋은 절대성공면입니다."
msgstr ""

#: scenes/help.tscn
msgid "무기의 공격 가산은 공격 굴림에, 방어구의 방어 가산은 AC와 내성 굴림에 더합니다. 명중하면 공격 능력치 주사위를 새로 굴리고 피해 보정을 더해 피해를 정합니다. 피해에는 유리/불리가 없습니다. 회전회오리는 시전자가 굴리지 않고 맞는 대상마다 힘 내성굴림을 합니다. 내성 굴림(내성 능력치 주사위 + 방어 가산)이 DC(시전 능력치 표준값 + 공격 가산) 이상이면 성공하고, 피해는 절반(최소 1)입니다. 밀치기·만능팔도 대상의 힘 내성굴림이며, 성공하면 밀리거나 끌려가지 않습니다. 밀치기는 기절한 대상과 아군을 판정 없이 밀어냅니다. 충격 화살은 명중하면 기절시키며 보스는 기절에 면역입니다. 독 제거는 건강 내성 굴림이 독의 DC 이상이면 성공합니다."
msgstr ""

#: scenes/help.tscn
msgid "반응은 조건이 맞으면 누구의 턴이든 쓰는 실행 기회입니다. 하나뿐이고 자기 턴 시작에 회복합니다. 지금은 기회 공격이 씁니다."
msgstr ""

#: scenes/help.tscn
msgid "기회 공격(전사·일부 적): 상대가 스스로 인접 칸을 벗어날 때 기본 공격을 합니다. 밀치기와 물러서며 쏘기의 이동은 기회 공격을 받지 않습니다."
msgstr ""

#: scenes/help.tscn
msgid "아군의 반응은 확인 창에서 쓸지 고릅니다. 적의 반응은 자동입니다."
msgstr ""

#: scenes/help.tscn
msgid "전사 스킬"
msgstr ""

#: scenes/help.tscn
msgid "휩쓸기는 인접한 칸을 눌러 정면을 정하고, 같은 칸을 다시 누르면 정면 반달 5칸의 적만 시계방향으로 각각 공격합니다. 반달에 적이 없어도 쓸 수 있고 행동을 소비합니다. 피해는 굴림값의 절반(올림)에 기타 가산치를 더합니다. 십자 베기는 행동과 보조 행동, 강철 돌진은 보조 행동과 이동력 1을 모두 써야 쓸 수 있습니다. 두 스킬과 전투의 함성은 전투마다 1회이고 새 전투에서 회복합니다. 강철 돌진은 명중하면 대상을 1칸 밀고 빈 칸으로 1칸 전진합니다. 대상이 쓰러지면 밀지 않고 그 칸으로 전진합니다. 대상이 살아 있는데 밀려날 칸이 막혔으면 피해만 줍니다."
msgstr ""

#: scenes/help.tscn
msgid "성스러운 장막의 방어막은 HP보다 먼저 모든 피해를 받습니다. 전투의 함성은 모든 아군의 명중굴림에 의지 굴림값을 더합니다. 두 효과의 남은 턴은 전사의 턴 시작마다 줄고, 전투의 함성은 전사가 쓰러져도 남습니다. 팔랑크스: 전사와 인접한 아군은 AC +1이고, 인접 아군이 있으면 전사도 AC +1입니다. 전사가 기절한 동안 꺼지고, 기절이 풀리면 다시 켜집니다."
msgstr ""

