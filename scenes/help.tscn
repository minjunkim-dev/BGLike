[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://scenes/ui_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scenes/help.gd" id="2_help"]

[node name="Help" type="ColorRect"]
process_mode = 3
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
color = Color(0.04, 0.06, 0.08, 1)
script = ExtResource("2_help")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 10

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Heading" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "도움말"

[node name="HelpScroll" type="ScrollContainer" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Topics" type="VBoxContainer" parent="Margin/Layout/HelpScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="MouseHeading" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "마우스"

[node name="Mouse1" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "빈 칸 우클릭: 이동 경로를 봅니다. 같은 칸을 다시 우클릭하면 이동합니다."
autowrap_mode = 3

[node name="MouseJump" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "점프: 스킬 바에서 점프를 고른 뒤 빈 칸을 우클릭해 착지 칸을 보고, 같은 칸을 다시 우클릭하면 뜁니다."
autowrap_mode = 3

[node name="Mouse2" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "적·나무 상자·바위 좌클릭: 고른 동작(처음에는 기본 공격)의 대상과 명중률 같은 미리보기를 봅니다. 같은 대상을 다시 좌클릭하면 실행합니다. 밀치기는 아군도 고를 수 있습니다."
autowrap_mode = 3

[node name="Mouse3" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "스킬 바 버튼: 스킬·밀치기·물약을 고릅니다. 자기에게 쓰는 동작은 같은 버튼을 다시 누르면 씁니다."
autowrap_mode = 3

[node name="Mouse4" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "초상: HP·AC·6능력치 주사위·상태를 봅니다. 현재 턴 묶음에서 조작 가능한 아군 초상을 누르면 해당 유닛을 조작합니다."
autowrap_mode = 3

[node name="Mouse5" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "턴 종료 버튼: 지금 유닛의 턴을 끝냅니다."
autowrap_mode = 3

[node name="KeysHeading" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "키보드·컨트롤러"

[node name="Keys1" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "숫자 키 1~9: 아군 턴에 스킬 바의 버튼을 왼쪽부터 고릅니다."
autowrap_mode = 3

[node name="Keys2" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "방향키·D-pad: 버튼 사이를 옮깁니다. 전투에서 포커스가 없으면 좌우 입력으로 스킬 바 첫 버튼에 들어갑니다. 도움말·출처 화면에서는 위아래로 글을 스크롤합니다."
autowrap_mode = 3

[node name="Keys3" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "Enter·컨트롤러 A: 포커스된 버튼을 누릅니다."
autowrap_mode = 3

[node name="Keys4" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "Tab: 같은 묶음의 다음 아군으로 바꿉니다. Shift+Tab은 이전 아군입니다. 바꿔도 자원은 회복하지 않습니다."
autowrap_mode = 3

[node name="Keys5" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "Space 누르고 있기: 적 턴을 4배로 빠르게 봅니다. 손을 떼면 보통 속도로 돌아옵니다."
autowrap_mode = 3

[node name="Keys6" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "Esc·컨트롤러 Start: 전투·정비 중에 일시정지 메뉴를 열고 닫습니다. 메뉴가 열려 있는 동안 전투가 멈춥니다. 반응 확인 창에서 Esc는 반응을 넘깁니다. 다른 확인 창과 설정·도움말·출처 화면은 Esc로 닫습니다."
autowrap_mode = 3

[node name="AdvantageHeading" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "유리 / 불리"

[node name="Advantage1" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "유리는 공격 능력치 주사위를 두 번 굴려 높은 값을, 불리는 낮은 값을 씁니다. 둘이 함께 있으면 서로 지워져 한 번만 굴립니다. 같은 쪽이 여러 개여도 두 번만 굴립니다."
autowrap_mode = 3

[node name="Advantage2" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "기절한 대상을 공격하면 유리입니다. 원거리 공격자의 인접 칸에 기절하지 않은 적이 있으면 불리입니다."
autowrap_mode = 3

[node name="Advantage3" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "명중굴림: 공격자만 공격 능력치 주사위를 굴리고, 공격 굴림이 대상의 AC 이상이면 명중합니다. 대상은 굴리지 않습니다. 명중률에는 유리/불리, 절대면, 장비 가산이 반영됩니다."
autowrap_mode = 3

[node name="SavesHeading" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "능력치 주사위와 AC"

[node name="Saves1" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "힘·민첩·솜씨·지능·의지·건강은 각각 능력치 주사위입니다. 공격 능력치는 무기·스킬이 정합니다(전사 힘, 아군 궁수 솜씨). AC는 민첩 주사위의 표준값(d4 3, d6 4, d8 5, d10 6, d12 7, d20 11)에 방어 가산을 더한 고정값입니다."
autowrap_mode = 3

[node name="Saves2" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "모든 주사위의 1은 절대실패, d12의 12와 d20의 18~20은 절대성공입니다. 절대성공은 AC와 무관하게 명중하고, 절대실패는 가산이 있어도 빗나갑니다. 무기의 공격 가산은 공격 굴림에, 방어구의 방어 가산은 AC에 더합니다. 충격 화살은 명중하면 기절시키며 보스는 기절에 면역입니다. 밀치기·만능팔·회전회오리는 아직 양쪽이 주사위를 굴리는 대결입니다. 독 제거는 건강 주사위가 독의 강도 이상이면 성공합니다."
autowrap_mode = 3

[node name="ReactionsHeading" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "반응"

[node name="Reactions1" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "반응은 조건이 맞으면 누구의 턴이든 쓰는 실행 기회입니다. 하나뿐이고 자기 턴 시작에 회복합니다. 기회 공격과 흘려내기가 함께 씁니다."
autowrap_mode = 3

[node name="Reactions2" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "기회 공격(전사·일부 적): 상대가 스스로 인접 칸을 벗어날 때 기본 공격을 합니다. 밀치기와 물러서며 쏘기의 이동은 기회 공격을 받지 않습니다."
autowrap_mode = 3

[node name="Reactions3" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "흘려내기(전사): 공격이 명중하면 피해를 굴리기 전에 씁니다. 민첩 주사위 +3이 그 공격의 공격 굴림 이상이면 공격을 피합니다."
autowrap_mode = 3

[node name="Reactions4" type="Label" parent="Margin/Layout/HelpScroll/Topics"]
layout_mode = 2
text = "아군의 반응은 확인 창에서 쓸지 고릅니다. 적의 반응은 자동입니다."
autowrap_mode = 3

[node name="HelpBack" type="Button" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(80, 20)
layout_mode = 2
size_flags_horizontal = 4
text = "뒤로"
